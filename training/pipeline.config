# Training config: fine-tune SSD MobileNet V2 FPNLite 320x320 (COCO17) on
# Indian vehicle classes. Small + fast enough for browser inference.
#
# Adjust num_classes to match training/label_map.pbtxt (10 here).

model {
  ssd {
    num_classes: 10
    box_coder {
      faster_rcnn_box_coder {
        y_scale: 10.0
        x_scale: 10.0
        h_scale: 5.0
        w_scale: 5.0
      }
    }
    matcher {
      argmax_matcher {
        matched_threshold: 0.5
        unmatched_threshold: 0.5
        ignore_thresholds: false
        negatives_lower_than_unmatched: true
        force_match_for_each_row: true
        use_matmul_gather: true
      }
    }
    similarity_calculator {
      iou_similarity {}
    }
    encode_background_as_zeros: true
    anchor_generator {
      ssd_anchor_generator {
        num_layers: 6
        min_scale: 0.2
        max_scale: 0.95
        aspect_ratios: 1.0
        aspect_ratios: 2.0
        aspect_ratios: 0.5
        aspect_ratios: 1.5
        aspect_ratios: 0.3333
      }
    }
    image_resizer {
      fixed_shape_resizer {
        height: 320
        width: 320
      }
    }
    box_predictor {
      convolutional_box_predictor {
        min_depth: 0
        max_depth: 0
        num_layers_before_predictor: 0
        use_dropout: false
        dropout_keep_probability: 0.8
        kernel_size: 3
        box_code_size: 4
        apply_sigmoid_to_scores: false
        class_prediction_bias_init: -4.6
      }
    }
    feature_extractor {
      type: 'ssd_mobilenet_v2'
      min_depth: 16
      depth_multiplier: 1.0
      use_depthwise: true
      conv_hyperparams {
        activation: RELU_6
        regularizer {
          l2_regularizer {
            weight: 0.00004
          }
        }
        initializer {
          random_normal_initializer {
            stddev: 0.03
            mean: 0.0
          }
        }
        batch_norm {
          train: true
          scale: true
          center: true
        }
      }
      override_base_feature_extractor_hyperparams: true
    }
    loss {
      classification_loss {
        weighted_sigmoid_focal {
          alpha: 0.75
          gamma: 2.0
        }
      }
      localization_loss {
        weighted_smooth_l1 {
          delta: 1.0
        }
      }
    }
    normalize_loss_by_num_matches: true
    normalize_loc_loss_by_codesize: true
  }
}

train_config {
  batch_size: 16
  sync_replicas: true
  startup_delay_steps: 0
  replicas_to_aggregate: 8
  num_steps: 200000
  data_augmentation_options {
    random_horizontal_flip {
    }
    ssd_random_crop {
    }
  }
  data_augmentation_options {
    random_horizontal_flip {
    }
  }
  optimizer {
    momentum_optimizer {
      learning_rate {
        cosine_decay_learning_rate {
          learning_rate_base: 0.9
          total_steps: 200000
          warmup_learning_rate: 0.1
          warmup_steps: 2000
        }
      }
      momentum_optimizer_value: 0.9
    }
  }
  max_number_of_boxes: 100
  unpad_groundtruth_tensors: false
  fine_tune_checkpoint: "PATH/TO/ssd_mobilenet_v2_fpnlite_320x320_coco17/model.ckpt"
  fine_tune_checkpoint_type: "detection"
}

fine_tuning_config {
  fine_tune_checkpoint: "PATH/TO/ssd_mobilenet_v2_fpnlite_320x320_coco17/model.ckpt"
  fine_tune_checkpoint_type: "detection"
}

train_input_reader {
  tf_record_input_reader {
    input_path: "data/train.record"
  }
  label_map_path: "data/label_map.pbtxt"
}

eval_config {
  metrics_set: "detection"
  metrics {
    config {
      eval_input_reader {
        label_map_path: "data/label_map.pbtxt"
      }
      num_examples: 500
      max_evals: 10
    }
  }
}

eval_input_reader {
  tf_record_input_reader {
    input_path: "data/val.record"
  }
  label_map_path: "data/label_map.pbtxt"
}

graph_rewriter {
  quantization {
    delay: 0
    weight_bits: 8
    activation_bits: 8
  }
}
